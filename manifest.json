{
  "manifest_version": 3,
  "name": "LK Tracker",
  "version": "0.1.0",
  "description": "Tracker de prospects LinkedIn",
  "permissions": ["storage", "activeTab", "tabs", "downloads", "identity", "notifications", "sidePanel"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "262452710216-i0ar8fdocno5r3tvo62ufid97pac68p3.apps.googleusercontent.com",
    "web_client_id": "262452710216-85kvqj5j9cf41igtvqf7k9g0okdj2u1n.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets"]
  },
  "action": {
    "default_title": "LK Tracker",
    "default_icon": "icon48.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
